# Copy to .env and fill in. The runner auto-loads .env via python-dotenv.
# Missing keys → runner skips that model with a warning (not a crash).

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
TOGETHER_API_KEY=...

# Optional base-URL overrides (for self-hosted gateways or non-default
# OpenAI-compatible endpoints):
# OPENAI_BASE_URL=https://api.openai.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
# TOGETHER_BASE_URL=https://api.together.xyz
